# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Editors
.idea/
.vscode/

# Logs
*.log

# Persistent OHLC disk cache (F5) — recreated per run, never commit
.ohlc_cache/

# Sector-map disk cache (F4) — monthly TTL, recreated on demand
.sector_cache/

# === Secrets / credentials (extra safety net) ===
# Never commit any file with these patterns. Secrets live ONLY in GitHub
# Actions repository secrets, never on disk.
.env
.env.*
*.token
*.secret
*.pem
*.key
credentials.*
secrets.*
*_token.json
*_secrets.json
config.local.*
