// --- MTF zone state updates (mark tested / remove invalidated) ---
if barstate.isconfirmed and array.size(mtfType) > 0
    nM = array.size(mtfType)
    jj = nM - 1
    while jj >= 0
        st = array.get(mtfState, jj)
        if st < 2
            t       = array.get(mtfType,    jj)
            tg      = array.get(mtfTfTag,   jj)
            pr      = array.get(mtfProx,    jj)
            ds      = array.get(mtfDist,    jj)
            bornBar = array.get(mtfBornBar, jj)
            // Use each HTF's own bar H/L so a single current-TF wick cannot erase a valid HTF zone
            float chkLow  = tg == 5 ? htf75L : tg == 6 ? htfDL : tg == 1 ? htfWL : tg == 2 ? htfML : tg == 3 ? htf3L : tg == 4 ? htf6L : low[1]
            float chkHigh = tg == 5 ? htf75H : tg == 6 ? htfDH : tg == 1 ? htfWH : tg == 2 ? htfMH : tg == 3 ? htf3H : tg == 4 ? htf6H : high[1]
            invalidated = false
            wasIn   = array.get(mtfWasInZone, jj)
            isIn    = false
            if bar_index > bornBar + 1
                if t == 1
                    isIn := chkLow <= pr
                    if chkLow < ds
                        invalidated := true
                    else if chkLow <= pr and st == 0
                        array.set(mtfState, jj, 1)
                        bx = array.get(mtfBoxArr, jj)
                        box.set_bgcolor(bx, color.new(f_mtfBgColor(tg, t), 90))
                else
                    isIn := chkHigh >= pr
                    if chkHigh > ds
                        invalidated := true
                    else if chkHigh >= pr and st == 0
                        array.set(mtfState, jj, 1)
                        bx = array.get(mtfBoxArr, jj)
                        box.set_bgcolor(bx, color.new(f_mtfBgColor(tg, t), 90))

                if not invalidated
                    if isIn and not wasIn
                        newCt = array.get(mtfTestCount, jj) + 1
                        if newCt >= 2
                            invalidated := true
                        else
                            array.set(mtfTestCount, jj, newCt)
                            array.set(mtfWasInZone, jj, true)
                            str   = array.get(mtfStrength,  jj)
                            bc    = array.get(mtfBaseCount, jj)
                            score = f_freshnessScore(newCt) + str + f_timeAtBaseScore(bc)
                            if score < effectiveMtfMinScore
                                invalidated := true
                    else if not isIn and wasIn
                        array.set(mtfWasInZone, jj, false)

            if invalidated
                bx = array.get(mtfBoxArr, jj)
                box.delete(bx)
                lbl = array.get(mtfLblArr, jj)
                if not na(lbl)
                    label.delete(lbl)
                array.remove(mtfType,      jj)
                array.remove(mtfTfTag,     jj)
                array.remove(mtfProx,      jj)
                array.remove(mtfDist,      jj)
                array.remove(mtfTime,      jj)
                array.remove(mtfBoxArr,    jj)
                array.remove(mtfLblArr,    jj)
                array.remove(mtfState,     jj)
                array.remove(mtfTestCount,   jj)
                array.remove(mtfWasInZone,   jj)
                array.remove(mtfStrength,    jj)
                array.remove(mtfBaseCount,   jj)
                array.remove(mtfBornBar,     jj)
        jj -= 1

// =============================================================================
// ZONE STATE UPDATES (Fresh / Tested / Invalid)
// Phase 4: also tracks test count (re-entries) for freshness scoring.
// =============================================================================
var int demandBreachCount = 0
var int supplyBreachCount = 0
var bool breachDemandThisBar = false
var bool breachSupplyThisBar = false

if barstate.isconfirmed and array.size(zType) > 0
    breachDemandThisBar := false
    breachSupplyThisBar := false

    n2 = array.size(zType)
    j = n2 - 1
    while j >= 0
        st = array.get(zState, j)
        if st < 2
            t  = array.get(zType, j)
            pr = array.get(zProx, j)
            ds = array.get(zDist, j)

            invalidated = false
            // low[1] at bar_index M = bar M-1's candle.
            // We must not invalidate using the legout, detection bar, or
            // confirmation candle — all of which are "inside" the zone creation
            // sequence. The first genuinely independent candle is at bar M-1
            // where M > bornBar + 1, i.e. bar_index > bornBar + 1.
            bornBar = array.get(zBornBar, j)
            wasIn = array.get(zWasInZone, j)
            isIn  = false
            if bar_index > bornBar + 1
                if t == 1
                    isIn := low[1] <= pr
                    if low[1] < ds
                        invalidated := true
                        breachDemandThisBar := true
                    else if low[1] <= pr and st == 0
                        array.set(zState, j, 1)
                        bx = array.get(zBoxArr, j)
                        box.set_bgcolor(bx, color.new(demandColor, testedFade))
                else
                    isIn := high[1] >= pr
                    if high[1] > ds
                        invalidated := true
                        breachSupplyThisBar := true
                    else if high[1] >= pr and st == 0
                        array.set(zState, j, 1)
                        bx = array.get(zBoxArr, j)
                        box.set_bgcolor(bx, color.new(supplyColor, testedFade))

            if not invalidated and bar_index > bornBar
                if isIn and not wasIn
                    array.set(zTestCount, j, array.get(zTestCount, j) + 1)
                    array.set(zWasInZone, j, true)
                else if not isIn and wasIn
                    array.set(zWasInZone, j, false)

            if invalidated
                bx = array.get(zBoxArr, j)
                box.delete(bx)
                pl = array.get(zProxLn, j)
                if not na(pl)
                    line.delete(pl)
                dl = array.get(zDistLn, j)
                if not na(dl)
                    line.delete(dl)
                lbl = array.get(zScoreLbl, j)
                if not na(lbl)
                    label.delete(lbl)
                gb = array.get(zGapBox, j)
                if not na(gb)
                    box.delete(gb)
                array.remove(zType,         j)
                array.remove(zProx,         j)
                array.remove(zDist,         j)
                array.remove(zLeft,         j)
                array.remove(zState,        j)
                array.remove(zBoxArr,       j)
                array.remove(zProxLn,       j)
                array.remove(zDistLn,       j)
                array.remove(zGapBox,       j)
                array.remove(zTestCount,    j)
                array.remove(zWasInZone,    j)
                array.remove(zBaseCount,    j)
                array.remove(zStrength,     j)
                array.remove(zScoreLbl,     j)
                array.remove(zCurrentScore, j)
                array.remove(zBornBar,      j)
        j -= 1

// Real-time invalidation: remove zones already violated by the current live bar
// (the barstate.isconfirmed loop uses high[1]/low[1] so it misses the current bar)
// Guard: bar_index > bornBar ensures we do not delete on the birth bar itself
// (direct zones: bornBar = detection bar; pending: bornBar = confirmation bar).
if barstate.islast and array.size(zType) > 0
    k = array.size(zType) - 1
    while k >= 0
        t       = array.get(zType,    k)
        ds      = array.get(zDist,    k)
        bornBar = array.get(zBornBar, k)
        violated = bar_index > bornBar and ((t == 1 and low <= ds) or (t != 1 and high >= ds))
        if violated
            bx = array.get(zBoxArr, k)
            box.delete(bx)
            pl = array.get(zProxLn, k)
            if not na(pl)
                line.delete(pl)
            dl = array.get(zDistLn, k)
            if not na(dl)
                line.delete(dl)
            lbl = array.get(zScoreLbl, k)
            if not na(lbl)
                label.delete(lbl)
            gb = array.get(zGapBox, k)
            if not na(gb)
                box.delete(gb)
            array.remove(zType,         k)
            array.remove(zProx,         k)
            array.remove(zDist,         k)
            array.remove(zLeft,         k)
            array.remove(zState,        k)
            array.remove(zBoxArr,       k)
            array.remove(zProxLn,       k)
            array.remove(zDistLn,       k)
            array.remove(zGapBox,       k)
            array.remove(zTestCount,    k)
            array.remove(zWasInZone,    k)
            array.remove(zBaseCount,    k)
            array.remove(zStrength,     k)
            array.remove(zScoreLbl,     k)
            array.remove(zCurrentScore, k)
            array.remove(zBornBar,      k)
        k -= 1

// =============================================================================
// PHASE 4: TRADE SCORE COMPUTATION + LABEL DRAWING
// Score = freshness (3 / 1.5 / 0) + strength (2 / 2 / 1) + time-at-base (2 / 1 / 0)
// Maximum 7. Per PDF pages 34-35.
// =============================================================================

if barstate.islast and array.size(zType) > 0
    nz = array.size(zType)
    for k = 0 to nz - 1
        // Compute score
        tc      = array.get(zTestCount, k)
        bc      = array.get(zBaseCount, k)
        str     = array.get(zStrength,  k)
        score   = f_freshnessScore(tc) + str + f_timeAtBaseScore(bc)
        array.set(zCurrentScore, k, score)

        // Delete old label if present
        oldLbl = array.get(zScoreLbl, k)
        if not na(oldLbl)
            label.delete(oldLbl)
            array.set(zScoreLbl, k, na)

        // Draw new label only if scoring is enabled and score meets threshold
        if showScore and score >= effectiveMinScore
            zt    = array.get(zType, k)
            pr    = array.get(zProx, k)
            ds    = array.get(zDist, k)
            leftB = array.get(zLeft, k)
            yPos  = math.max(pr, ds)
            xPos  = math.max(leftB + 3, bar_index - 490)
            fScore = f_freshnessScore(tc)
            bScore = f_timeAtBaseScore(bc)
            // Breakdown: total | F:freshness S:strength B:base
            scoreTxt = str.tostring(math.round(score * 10) / 10) + " | F:" + str.tostring(fScore) + " S:" + str.tostring(str) + " B:" + str.tostring(bScore) + " (bc:" + str.tostring(bc) + " tc:" + str.tostring(tc) + ")"
            newLbl = label.new(xPos, yPos, scoreTxt, style = label.style_label_down, color = scoreLabelColor, textcolor = color.white, size = size.small)
            array.set(zScoreLbl, k, newLbl)
        else if not showScore
            // Make sure label is gone when toggle is off
            existing = array.get(zScoreLbl, k)
            if not na(existing)
                label.delete(existing)
                array.set(zScoreLbl, k, na)

// =============================================================================
// PHASE 4: HIDE ZONES BELOW MINIMUM SCORE
// When user sets a minimum score, zones below it should not just lose their
// score label but be visually hidden (box transparent).
// =============================================================================
if barstate.islast and array.size(zType) > 0 and effectiveMinScore > 0
    nz2 = array.size(zType)
    for k = 0 to nz2 - 1
        score = array.get(zCurrentScore, k)
        bx = array.get(zBoxArr, k)
        pl = array.get(zProxLn, k)
        dl = array.get(zDistLn, k)
        if score < effectiveMinScore
            // Hide box and lines: full transparency
            box.set_bgcolor(bx, color.new(color.gray, 100))
            box.set_border_color(bx, color.new(color.gray, 100))
            if not na(pl)
                line.set_color(pl, color.new(color.gray, 100))
            if not na(dl)
                line.set_color(dl, color.new(color.gray, 100))
        else
            // Restore appropriate color based on current state
            zt = array.get(zType, k)
            st = array.get(zState, k)
            baseColor = zt == 1 ? demandColor : supplyColor
            if st == 0
                box.set_bgcolor(bx, baseColor)
            else
                box.set_bgcolor(bx, color.new(baseColor, testedFade))
            if not na(pl)
                line.set_color(pl, zt == 1 ? color.new(color.green, 0) : color.new(color.red, 0))
            if not na(dl)
                line.set_color(dl, zt == 1 ? color.new(color.green, 30) : color.new(color.red, 30))



// =============================================================================
// TRADE SETUP (Phase 3)
// =============================================================================
// On every confirmed bar, find:
//   * Nearest fresh DEMAND zone below current price (highest proximal that's
//     still below current close).
//   * Nearest fresh SUPPLY zone above current price (lowest proximal that's
//     still above current close).
// Draw entry / stop loss / target lines for each, with the configured R:R.
// Lines are redrawn every bar so they track the "nearest" zones as price moves.
// =============================================================================

// Persistent line/label handles so we can delete and recreate each bar.
var line   setupDemandEntry  = na
var line   setupDemandSL     = na
var line   setupDemandTgt    = na
var label  setupDemandEntryL = na
var label  setupDemandSLL    = na
var label  setupDemandTgtL   = na

var line   setupSupplyEntry  = na
var line   setupSupplySL     = na
var line   setupSupplyTgt    = na
var label  setupSupplyEntryL = na
var label  setupSupplySLL    = na
var label  setupSupplyTgtL   = na

// Helper: delete a line if it exists
f_delLine(ln) =>
    if not na(ln)
        line.delete(ln)

f_delLabel(lbl) =>
    if not na(lbl)
        label.delete(lbl)

// Always clean up previous setup drawings on the last bar so that toggling
// "Show trade setup lines" off actually removes the lines from the chart.
if barstate.islast
    f_delLine(setupDemandEntry)
    f_delLine(setupDemandSL)
    f_delLine(setupDemandTgt)
    f_delLabel(setupDemandEntryL)
    f_delLabel(setupDemandSLL)
    f_delLabel(setupDemandTgtL)
    f_delLine(setupSupplyEntry)
    f_delLine(setupSupplySL)
    f_delLine(setupSupplyTgt)
    f_delLabel(setupSupplyEntryL)
    f_delLabel(setupSupplySLL)
    f_delLabel(setupSupplyTgtL)
    setupDemandEntry  := na
    setupDemandSL     := na
    setupDemandTgt    := na
    setupDemandEntryL := na
    setupDemandSLL    := na
    setupDemandTgtL   := na
    setupSupplyEntry  := na
    setupSupplySL     := na
    setupSupplyTgt    := na
    setupSupplyEntryL := na
    setupSupplySLL    := na
    setupSupplyTgtL   := na

if showSetup and barstate.islast and array.size(zType) > 0
    // Find the nearest fresh zones above and below price
    int   bestDemandIdx = -1
    float bestDemandProx = na
    int   bestSupplyIdx = -1
    float bestSupplyProx = na

    nz = array.size(zType)
    for k = 0 to nz - 1
        st = array.get(zState, k)
        if st < 2  // fresh or tested (not invalid)
            t  = array.get(zType, k)
            pr = array.get(zProx, k)
            if t == 1 and pr < close
                // Demand below price: we want the HIGHEST proximal (closest to price from below)
                if na(bestDemandProx) or pr > bestDemandProx
                    bestDemandProx := pr
                    bestDemandIdx  := k
            else if t == -1 and pr > close
                // Supply above price: we want the LOWEST proximal (closest to price from above)
                if na(bestSupplyProx) or pr < bestSupplyProx
                    bestSupplyProx := pr
                    bestSupplyIdx  := k

    // Draw setup for nearest demand
    if bestDemandIdx >= 0
        prox = array.get(zProx, bestDemandIdx)
        dist = array.get(zDist, bestDemandIdx)
        // Demand: entry just above proximal, SL just below distal, target above entry
        bufferAmt = prox * setupBufferPct / 100.0
        entry  = prox + bufferAmt
        sl     = dist - bufferAmt
        risk   = entry - sl
        target = entry + setupRR * risk

        leftBar = bar_index - 5
        rightBar = bar_index + 30

        setupDemandEntry := line.new(leftBar, entry,  rightBar, entry,  color = setupEntryColor, width = 2,                          extend = extend.right)
        setupDemandSL    := line.new(leftBar, sl,     rightBar, sl,     color = setupSlColor,    width = 1, style = line.style_dashed, extend = extend.right)
        setupDemandTgt   := line.new(leftBar, target, rightBar, target, color = setupTgtColor,   width = 1, style = line.style_dashed, extend = extend.right)

        if setupShowLabels
            rrTxt = str.tostring(math.round(setupRR * 100) / 100)
            setupDemandEntryL := label.new(rightBar, entry,  "Entry @ " + str.tostring(math.round(entry * 100) / 100),                  style = label.style_label_left, color = setupEntryColor, textcolor = color.black, size = size.small)
            setupDemandSLL    := label.new(rightBar, sl,     "SL @ "    + str.tostring(math.round(sl    * 100) / 100),                  style = label.style_label_left, color = setupSlColor,    textcolor = color.white, size = size.small)
            setupDemandTgtL   := label.new(rightBar, target, "TGT @ "   + str.tostring(math.round(target* 100) / 100) + "  R:R " + rrTxt, style = label.style_label_left, color = setupTgtColor,   textcolor = color.white, size = size.small)

    // Draw setup for nearest supply
    if bestSupplyIdx >= 0
        prox = array.get(zProx, bestSupplyIdx)
        dist = array.get(zDist, bestSupplyIdx)
        // Supply: entry just below proximal, SL just above distal, target below entry
        bufferAmt = prox * setupBufferPct / 100.0
        entry  = prox - bufferAmt
        sl     = dist + bufferAmt
        risk   = sl - entry
        target = entry - setupRR * risk

        leftBar = bar_index - 5
        rightBar = bar_index + 30

        setupSupplyEntry := line.new(leftBar, entry,  rightBar, entry,  color = setupEntryColor, width = 2,                          extend = extend.right)
        setupSupplySL    := line.new(leftBar, sl,     rightBar, sl,     color = setupSlColor,    width = 1, style = line.style_dashed, extend = extend.right)
        setupSupplyTgt   := line.new(leftBar, target, rightBar, target, color = setupTgtColor,   width = 1, style = line.style_dashed, extend = extend.right)

        if setupShowLabels
            rrTxt = str.tostring(math.round(setupRR * 100) / 100)
            setupSupplyEntryL := label.new(rightBar, entry,  "Entry @ " + str.tostring(math.round(entry * 100) / 100),                  style = label.style_label_left, color = setupEntryColor, textcolor = color.black, size = size.small)
            setupSupplySLL    := label.new(rightBar, sl,     "SL @ "    + str.tostring(math.round(sl    * 100) / 100),                  style = label.style_label_left, color = setupSlColor,    textcolor = color.white, size = size.small)
            setupSupplyTgtL   := label.new(rightBar, target, "TGT @ "   + str.tostring(math.round(target* 100) / 100) + "  R:R " + rrTxt, style = label.style_label_left, color = setupTgtColor,   textcolor = color.white, size = size.small)

// =============================================================================
// TREND
// =============================================================================
sma50 = ta.sma(close, 50)
slope7      = (sma50 - sma50[7]) / 7.0
slopePct    = close > 0 ? slope7 / close * 100.0 : 0.0
flatThresh  = 0.05

normalTrend = slopePct > flatThresh ? "Uptrend" : slopePct < -flatThresh ? "Downtrend" : "Sideways"

var string advTrend = "Sideways"
if barstate.isfirst
    advTrend := normalTrend

if barstate.isconfirmed
    if advTrend == "Uptrend"
        if breachDemandThisBar
            demandBreachCount += 1
            if demandBreachCount == 1
                advTrend := "Sideways"
                demandBreachCount := 0
                supplyBreachCount := 0
            else if demandBreachCount >= 2
                advTrend := "Downtrend"
                demandBreachCount := 0
                supplyBreachCount := 0
    else if advTrend == "Downtrend"
        if breachSupplyThisBar
            supplyBreachCount += 1
            if supplyBreachCount == 1
                advTrend := "Sideways"
                demandBreachCount := 0
                supplyBreachCount := 0
            else if supplyBreachCount >= 2
                advTrend := "Uptrend"
                demandBreachCount := 0
                supplyBreachCount := 0
    else
        if breachDemandThisBar
            demandBreachCount += 1
            if demandBreachCount >= 2
                advTrend := "Downtrend"
                demandBreachCount := 0
                supplyBreachCount := 0
        if breachSupplyThisBar
            supplyBreachCount += 1
            if supplyBreachCount >= 2
                advTrend := "Uptrend"
                demandBreachCount := 0
                supplyBreachCount := 0

trendOut = trendMode == "Normal" ? normalTrend : advTrend

var label trendLbl = na
if showTrendLabel and barstate.islast
    if not na(trendLbl)
        label.delete(trendLbl)
    txt = "Trend: " + trendOut + " (" + trendMode + ")"
    bg  = trendOut == "Uptrend" ? color.new(color.green, 30) : trendOut == "Downtrend" ? color.new(color.red, 30) : color.new(color.gray, 30)
    trendLbl := label.new(bar_index, high + (high - low) * 0.5, txt, style = label.style_label_down, color = bg, textcolor = color.white, size = size.normal)

// =============================================================================
// PHASE 6: TREND PANEL & INFO TABLE
// =============================================================================
// Multi-row table showing:
//   Row 1-3: Daily / Weekly / Monthly trend (colour coded)
//   Row 4:   Volume info (highest 10 bar, current vs avg)
//   Row 5-6: EMA 20 and EMA 50 values
//   Row 7:   Sector
// Position is configurable.
// =============================================================================

// --- Fetch HTF trend values via request.security ---
// Daily 50 SMA slope (used when chart is intraday)
dSma50      = request.security(syminfo.tickerid, "D", ta.sma(close, 50), lookahead = barmerge.lookahead_off)
dSma50Prev  = request.security(syminfo.tickerid, "D", ta.sma(close, 50)[7], lookahead = barmerge.lookahead_off)
dSlopePct   = not na(dSma50) and not na(dSma50Prev) and close > 0 ? (dSma50 - dSma50Prev) / 7.0 / close * 100.0 : 0.0
dTrend      = dSlopePct > flatThresh ? "Uptrend" : dSlopePct < -flatThresh ? "Downtrend" : "Sideways"

// Weekly 50 SMA slope
wkSma50      = request.security(syminfo.tickerid, "W", ta.sma(close, 50), lookahead = barmerge.lookahead_off)
wkSma50Prev  = request.security(syminfo.tickerid, "W", ta.sma(close, 50)[7], lookahead = barmerge.lookahead_off)
wkSlopePct   = not na(wkSma50) and not na(wkSma50Prev) and close > 0 ? (wkSma50 - wkSma50Prev) / 7.0 / close * 100.0 : 0.0
wkTrend      = wkSlopePct > flatThresh ? "Uptrend" : wkSlopePct < -flatThresh ? "Downtrend" : "Sideways"

// Monthly 50 SMA slope
moSma50      = request.security(syminfo.tickerid, "M", ta.sma(close, 50), lookahead = barmerge.lookahead_off)
moSma50Prev  = request.security(syminfo.tickerid, "M", ta.sma(close, 50)[7], lookahead = barmerge.lookahead_off)
moSlopePct   = not na(moSma50) and not na(moSma50Prev) and close > 0 ? (moSma50 - moSma50Prev) / 7.0 / close * 100.0 : 0.0
moTrend      = moSlopePct > flatThresh ? "Uptrend" : moSlopePct < -flatThresh ? "Downtrend" : "Sideways"

// 15-min SMA slope (for 5-min chart HTF trend)
m15Sma50     = request.security(syminfo.tickerid, "15", ta.sma(close, 50), lookahead = barmerge.lookahead_off)
m15Sma50Prev = request.security(syminfo.tickerid, "15", ta.sma(close, 50)[7], lookahead = barmerge.lookahead_off)
m15SlopePct  = not na(m15Sma50) and not na(m15Sma50Prev) and close > 0 ? (m15Sma50 - m15Sma50Prev) / 7.0 / close * 100.0 : 0.0
m15Trend     = m15SlopePct > flatThresh ? "Uptrend" : m15SlopePct < -flatThresh ? "Downtrend" : "Sideways"

// 75-min SMA slope (for 15-min chart HTF trend)
m75Sma50     = request.security(syminfo.tickerid, "75", ta.sma(close, 50), lookahead = barmerge.lookahead_off)
m75Sma50Prev = request.security(syminfo.tickerid, "75", ta.sma(close, 50)[7], lookahead = barmerge.lookahead_off)
m75SlopePct  = not na(m75Sma50) and not na(m75Sma50Prev) and close > 0 ? (m75Sma50 - m75Sma50Prev) / 7.0 / close * 100.0 : 0.0
m75Trend     = m75SlopePct > flatThresh ? "Uptrend" : m75SlopePct < -flatThresh ? "Downtrend" : "Sideways"

// Weekly and Monthly EMA values
wkEma20 = request.security(syminfo.tickerid, "W", ta.ema(close, 20), lookahead = barmerge.lookahead_off)
wkEma50 = request.security(syminfo.tickerid, "W", ta.ema(close, 50), lookahead = barmerge.lookahead_off)
moEma20 = request.security(syminfo.tickerid, "M", ta.ema(close, 20), lookahead = barmerge.lookahead_off)
moEma50 = request.security(syminfo.tickerid, "M", ta.ema(close, 50), lookahead = barmerge.lookahead_off)

// Volume info
highVol10    = ta.highest(volume, volLookback)
avgVol10     = ta.sma(volume, volLookback)
volRatio     = avgVol10 > 0 ? volume / avgVol10 : 0.0

// Helper: trend colour
f_trendColor(t) =>
    t == "Uptrend" ? color.new(color.green, 20) : t == "Downtrend" ? color.new(color.red, 20) : color.new(color.gray, 40)

// Helper: format large numbers (volume)
f_fmtVol(v) =>
    if v >= 10000000
        str.tostring(math.round(v / 1000000.0 * 10) / 10) + "M"
    else if v >= 100000
        str.tostring(math.round(v / 100000.0 * 10) / 10) + "L"
    else if v >= 1000
        str.tostring(math.round(v / 1000.0 * 10) / 10) + "K"
    else
        str.tostring(math.round(v))

// Helper: format price
f_fmtPrice(v) =>
    str.tostring(math.round(v * 100) / 100)

// Panel position mapping
f_panelPos(pos) =>
    if pos == "Top Right"
        position.top_right
    else if pos == "Top Left"
        position.top_left
    else if pos == "Bottom Right"
        position.bottom_right
    else if pos == "Bottom Left"
        position.bottom_left
    else if pos == "Middle Right"
        position.middle_right
    else
        position.middle_left

// Text size mapping
f_txtSize(sz) =>
    if sz == "tiny"
        size.tiny
    else if sz == "small"
        size.small
    else
        size.normal

// Build the table
var table infoPanel = na

if showPanel and barstate.islast
    if not na(infoPanel)
        table.delete(infoPanel)

    // Count rows needed
    nRows = 1  // 1 dynamic HTF trend row
    if showVolTable
        nRows += 2  // volume rows
    if showEmaTable
        nRows += 4  // EMA 20/50 per D+W+M condensed into 2 rows
    if showSectorTable
        nRows += 1

    infoPanel := table.new(f_panelPos(panelPosition), columns = 2, rows = nRows, bgcolor = panelBgColor, border_color = color.new(color.gray, 60), border_width = 1, frame_color = color.new(color.gray, 40), frame_width = 1)

    txtSz = f_txtSize(panelTextSize)
    row = 0

    // --- Dynamic HTF trend row (1 level above current TF) ---
    htfLabel    = timeframe.period == "5" ? "15m Trend" : timeframe.period == "15" ? "75m Trend" : timeframe.isintraday ? "Daily Trend"  : timeframe.isdaily ? "Weekly Trend" : "Monthly Trend"
    htfTrendStr = timeframe.period == "5" ? m15Trend   : timeframe.period == "15" ? m75Trend   : timeframe.isintraday ? dTrend         : timeframe.isdaily ? wkTrend        : moTrend
    htfColor    = f_trendColor(htfTrendStr)
    table.cell(infoPanel, 0, row, htfLabel,    text_color = panelTextColor, text_size = txtSz, bgcolor = panelBgColor)
    table.cell(infoPanel, 1, row, htfTrendStr, text_color = color.white,    text_size = txtSz, bgcolor = htfColor)
    row += 1

    // --- Volume rows ---
    if showVolTable
        highVolFmt = f_fmtVol(highVol10)
        table.cell(infoPanel, 0, row, "High Vol (" + str.tostring(volLookback) + ")", text_color = panelTextColor, text_size = txtSz, bgcolor = panelBgColor)
        table.cell(infoPanel, 1, row, highVolFmt,   text_color = panelTextColor, text_size = txtSz, bgcolor = panelBgColor)
        row += 1

        ratioTxt  = str.tostring(math.round(volRatio * 100) / 100) + "x avg"
        ratioColor = volRatio >= 2.0 ? color.new(color.orange, 20) : volRatio >= 1.0 ? color.new(color.green, 50) : panelBgColor
        table.cell(infoPanel, 0, row, "Vol vs Avg",   text_color = panelTextColor, text_size = txtSz, bgcolor = panelBgColor)
        table.cell(infoPanel, 1, row, ratioTxt,       text_color = panelTextColor, text_size = txtSz, bgcolor = ratioColor)
        row += 1

    // --- EMA rows ---
    if showEmaTable
        ema20Val = ta.ema(close, 20)
        ema50Val = ta.ema(close, 50)
        table.cell(infoPanel, 0, row, "EMA 20 (D/W/M)", text_color = panelTextColor, text_size = txtSz, bgcolor = panelBgColor)
        table.cell(infoPanel, 1, row, f_fmtPrice(ema20Val) + " / " + f_fmtPrice(wkEma20) + " / " + f_fmtPrice(moEma20), text_color = panelTextColor, text_size = txtSz, bgcolor = panelBgColor)
        row += 1

        table.cell(infoPanel, 0, row, "EMA 50 (D/W/M)", text_color = panelTextColor, text_size = txtSz, bgcolor = panelBgColor)
        table.cell(infoPanel, 1, row, f_fmtPrice(ema50Val) + " / " + f_fmtPrice(wkEma50) + " / " + f_fmtPrice(moEma50), text_color = panelTextColor, text_size = txtSz, bgcolor = panelBgColor)
        row += 1

    // --- Sector row ---
    if showSectorTable
        table.cell(infoPanel, 0, row, "Sector",        text_color = panelTextColor, text_size = txtSz, bgcolor = panelBgColor)
        table.cell(infoPanel, 1, row, syminfo.sector,  text_color = panelTextColor, text_size = txtSz, bgcolor = panelBgColor)

// =============================================================================
// EMAs
// =============================================================================
ema5  = ta.ema(close, 5)
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
plot(showEma5  ? ema5  : na, "EMA 5",  color = ema5Color,  linewidth = 2)
plot(showEma20 ? ema20 : na, "EMA 20", color = ema20Color, linewidth = 2)
plot(showEma50 ? ema50 : na, "EMA 50", color = ema50Color, linewidth = 2)
plot(showSma50 ? sma50 : na, "SMA 50", color = sma50Color, linewidth = 2)
