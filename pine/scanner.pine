//@version=6
// =============================================================================
// IDEAL Zone Screener — Unified Stock Scanner
// Covers all stock batches A-M (520 stocks) via a single Batch dropdown.
// Selecting a batch loads that group's 40 symbols; the script reloads.
// Same IDEAL detection logic as the per-batch scanners.
//
// Note: Pine Script v5 limits to 40 request.security() calls per script.
// =============================================================================
indicator("IDEAL Near Zone Scanner — Unified", shorttitle = "IDEAL Scanner", overlay = false)

// =============================================================================
// INPUTS
// =============================================================================

grpBatch = "Stock Universe"
batch = input.string("A", "Stock Batch",
     options = ["A","B","C","D","E","F","G","H","I","J","K","L","M","indices"],
     group = grpBatch,
     tooltip = "Select which group of 40 stocks to scan. A=Nifty50, B-M=other NSE stocks, indices=NSE sector/broad indices.")

grpScan = "Scanner Settings"
scanMode       = input.string("Both",   "Scan for zones",     options = ["Demand only", "Supply only", "Both"], group = grpScan)
minDistPct     = input.float(0.0,  "Min % from proximal", minval = 0.0, maxval = 20.0, step = 0.5,  group = grpScan, tooltip = "Price must be at least this % away from the zone proximal.")
maxDistPct     = input.float(7.0, "Max % from proximal", minval = 0.5, maxval = 30.0, step = 0.5,  group = grpScan, tooltip = "Price must be within this % of the zone proximal.")

grpFilter = "Filters"
useTrendFilter = input.bool(false, "Trend filter",   group = grpFilter, tooltip = "Demand zones: only show if stock is in Uptrend. Supply zones: only if Downtrend.")
useScoreFilter = input.bool(true,  "Score filter",   group = grpFilter, tooltip = "Only show zones with trade score >= minimum.")
minScore       = input.float(7.0,  "Minimum score",  minval = 0.0, maxval = 7.0, step = 0.5, group = grpFilter)
maxZoneTests   = input.int(1,     "Max zone tests (0=fresh only, 1=+tested once)", minval = 0, maxval = 2, group = grpFilter)
maxHtfZoneTests = input.int(1,    "Max HTF zone tests (0=fresh only, 1=+tested once)", minval = 0, maxval = 2, group = grpFilter)

grpDetect = "Detection Settings"
basePct        = input.float(0.50, "Base candle body % (max)",   minval = 0.1, maxval = 0.9, step = 0.05, group = grpDetect)
excitePct      = input.float(0.50, "Exciting candle body % (min)", minval = 0.1, maxval = 0.9, step = 0.05, group = grpDetect)
legoutMinRatio         = input.float(0.8,  "Legout / legin min ratio",          minval = 0.5,  maxval = 1.0,  step = 0.05, group = grpDetect)
maxBase                = input.int(3,      "Max base candles",                  minval = 1,    maxval = 5,               group = grpDetect)
allowSmallBodyOverride = input.bool(true,  "Small body override",                                                        group = grpDetect, tooltip = "Treat a candle as a base if its body is tiny vs both the legout and legin, even when bodyPct exceeds the base threshold.")
smallBodyVsLegout      = input.float(0.30, "Small body: max % of legout body",  minval = 0.05, maxval = 0.6,  step = 0.05, group = grpDetect)
smallBodyVsLegin       = input.float(0.30, "Small body: max % of legin body",   minval = 0.05, maxval = 0.6,  step = 0.05, group = grpDetect)
allowZeroBase          = input.bool(true,  "Allow zero-base zones",                                                      group = grpDetect, tooltip = "Detect engulfing spike reversals with no base candle between legin and legout.")
lookbackBars           = input.int(50,     "Zone lookback (bars)",               minval = 10,   maxval = 200,             group = grpDetect, tooltip = "How many bars back to scan for zone formations. 50 matches the indicator's effective detection window.")
// rrRatio        = input.float(2.0,  "R:R for target",             minval = 1.0, maxval = 5.0, step = 0.25, group = grpDetect)
bufferPct      = input.float(0.5,  "Entry / SL buffer %",        minval = 0.0, maxval = 2.0, step = 0.1,  group = grpDetect)

grpTable = "Table"
tablePos  = input.string("Top", "Position", options = ["Top", "Bottom"], group = grpTable)
// showEntry = input.bool(true, "Show Entry / SL / Target", group = grpTable)

grpAlert = "Alerts"
enableAlerts  = input.bool(true,  "Enable zone-approach alerts", group = grpAlert, tooltip = "Fires a dynamic alert() message when price crosses the entry line. Only active on Daily and Weekly timeframes. Create one TradingView alert: Condition = this script, 'Any alert() function call'.")
alertDemand   = input.bool(true,  "Alert on demand approach",    group = grpAlert)
alertSupply   = input.bool(true,  "Alert on supply approach",    group = grpAlert)
alertEntryPct = input.float(0.5,  "Entry line % from proximal",  minval = 0.0, maxval = 5.0, step = 0.05, group = grpAlert, tooltip = "Entry line = proximal + this % (demand) / proximal - this % (supply). Alert fires when price crosses this line approaching the zone. Pick 0.05, 0.1, 0.5, 1.0, etc.")
alertMinScore = input.float(7.0,  "Alert min score",             minval = 0.0, maxval = 7.0, step = 0.5,  group = grpAlert, tooltip = "Only fire alerts for zones whose score >= this value. Independent of the table's score filter. Set 0 to alert on every approach.")
alertOnlyQualified = input.bool(true, "Apply trend filter to alerts", group = grpAlert, tooltip = "Also require zone trend to match (demand=Uptrend, supply=Downtrend). Score filter is separate (see above).")
useStrictFilter = input.bool(true, "Strict filter (HTF trend + MTF confluence)", group = grpAlert, tooltip = "Demand alert: requires HTF trend = Up AND price closer to HTF demand zone than HTF supply (or no HTF supply zone). Supply alert: mirror. Same logic as the Python scanner STRICT_FILTER.")

