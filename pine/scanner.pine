// =============================================================================
// --- Session-aligned 75-min boundary helper ---
f_is75mBoundary() =>
    var int _dayStart75   = na
    var int _prevBucket75 = -1
    if session.isfirstbar
        _dayStart75   := time
        _prevBucket75 := -1
    _mins = na(_dayStart75) ? 0 : int((time - _dayStart75) / 60000)
    _bkt  = _mins / 75
    _isBnd = session.isfirstbar or _bkt > _prevBucket75
    _prevBucket75 := _bkt
    _isBnd

// ZONE DETECTION FUNCTION  (mirrors zones.pine logic exactly)
// Runs inside request.security() context for each stock.
// Returns: [demDistPct, demProx, demDist, demScore,
//           supDistPct, supProx, supDist, supScore, trendDir]
//
// Includes: standard zones, small-body override, zero-base (engulfing)
//           zones, confirmation-candle zones, gap strength scoring.
// Marking: Body to Wick (IDEAL default). Freshness tracked live (0=fresh, 1=tested once).
// -999 = no zone found.  trendDir: 1=Up, -1=Down, 0=Side (50 SMA slope).
// =============================================================================
f_scanZones() =>
    // --- Trend via 50 SMA clock method ---
    sma50v   = ta.sma(close, 50)
    slopeVal = close > 0 ? (sma50v - sma50v[7]) / 7.0 / close * 100.0 : 0.0
    trendDir = slopeVal > 0.05 ? 1 : slopeVal < -0.05 ? -1 : 0
    bool _m75bnd     = f_is75mBoundary()

    // --- HTF trend: weekly closes on daily chart, monthly closes on weekly chart ---
    var float[] htfCloses = array.new<float>()
    bool htfChange = timeframe.period == "5" ? timeframe.change("15") : timeframe.period == "15" ? _m75bnd : (timeframe.isintraday and timeframe.change("D")) or (timeframe.isdaily and timeframe.change("W")) or (timeframe.isweekly and timeframe.change("M")) or (timeframe.ismonthly and timeframe.change("3M"))
    if htfChange and not na(close[1])
        array.unshift(htfCloses, close[1])
        if array.size(htfCloses) > 57
            array.pop(htfCloses)
    float htfTrendDir = 0.0
    if array.size(htfCloses) >= 57
        float s1 = 0.0
        float s2 = 0.0
        for i = 0 to 49
            s1 += array.get(htfCloses, i)
            s2 += array.get(htfCloses, i + 7)
        htfSma   = s1 / 50.0
        htfSma7  = s2 / 50.0
        htfSlope = close > 0 ? (htfSma - htfSma7) / 7.0 / close * 100.0 : 0.0
        htfTrendDir := htfSlope > 0.05 ? 1.0 : htfSlope < -0.05 ? -1.0 : 0.0

    // --- HTF zone detection: weekly OHLC on intraday, monthly OHLC on daily ---
    // Tests and invalidation are checked at HTF bar close only (not per intraday bar).
    bool htfZoneChange = timeframe.period == "5" ? _m75bnd : timeframe.period == "15" ? timeframe.change("D") : (timeframe.isintraday and timeframe.change("W")) or (timeframe.isdaily and timeframe.change("M")) or (timeframe.isweekly and timeframe.change("3M")) or (timeframe.ismonthly and timeframe.change("6M"))
    var float htfRunO = na
    var float htfRunH = na
    var float htfRunL = na
    var float[] hzO   = array.new<float>()
    var float[] hzH   = array.new<float>()
    var float[] hzL   = array.new<float>()
    var float[] hzC   = array.new<float>()

    var float htfDP     = na
    var float htfDD     = na
    var float htfDBS    = 0.0
    var int   htfDTc    = 0
    var bool  htfDWasIn = false
    var float htfSP     = na
    var float htfSD     = na
    var float htfSBS    = 0.0
    var int   htfSTc    = 0
    var bool  htfSWasIn = false

    if htfZoneChange and not na(htfRunO)
        // 1. Test / invalidate with the COMPLETED HTF bar (htfRunH/L before reset)
        if not na(htfDP)
            if htfRunL < htfDD
                htfDP := na
                htfDD := na
            else
                htfDIn = htfRunL <= htfDP
                if htfDIn and not htfDWasIn
                    htfDTc    += 1
                    htfDWasIn := true
                else if not htfDIn and htfDWasIn
                    htfDWasIn := false
        if not na(htfSP)
            if htfRunH > htfSD
                htfSP := na
                htfSD := na
            else
                htfSIn = htfRunH >= htfSP
                if htfSIn and not htfSWasIn
                    htfSTc    += 1
                    htfSWasIn := true
                else if not htfSIn and htfSWasIn
                    htfSWasIn := false

        // 2. Store completed HTF bar OHLC
        array.unshift(hzO, htfRunO)
        array.unshift(hzH, htfRunH)
        array.unshift(hzL, htfRunL)
        array.unshift(hzC, close[1])
        if array.size(hzO) > 60
            array.pop(hzO)
            array.pop(hzH)
            array.pop(hzL)
            array.pop(hzC)

        // 3. Reset accumulators for new HTF period
        htfRunO := open
        htfRunH := high
        htfRunL := low

        // 4. Detect new HTF zones — scan all stored bars as legout candidates
        int hzSize = array.size(hzO)
        if hzSize >= 3
            for hLegoutIdx = 0 to hzSize - 3
                hLo    = array.get(hzO, hLegoutIdx)
                hLh    = array.get(hzH, hLegoutIdx)
                hLl    = array.get(hzL, hLegoutIdx)
                hLc    = array.get(hzC, hLegoutIdx)
                hLbody = math.abs(hLc - hLo)
                hLrng  = hLh - hLl
                hLbPct = hLrng > 0 ? hLbody / hLrng : 0.0
                hLgrn  = hLc > hLo
                hLred  = hLc < hLo
                if hLbody > 0 and (hLgrn or hLred) and hLbPct >= excitePct
                    int   hBCnt = 0
                    int   hii   = hLegoutIdx + 1
                    float hBHB  = na
                    float hBLB  = na
                    float hBHW  = na
                    float hBLW  = na
                    bool  hGo   = true
                    while hGo and hBCnt < 3 and hii < hzSize - 1
                        ho_i = array.get(hzO, hii)
                        hh_i = array.get(hzH, hii)
                        hl_i = array.get(hzL, hii)
                        hc_i = array.get(hzC, hii)
                        hb_i = math.abs(hc_i - ho_i)
                        hr_i = hh_i - hl_i
                        hp_i = hr_i > 0 ? hb_i / hr_i : 0.0
                        if hp_i < basePct
                            hBHB := na(hBHB) ? math.max(ho_i,hc_i) : math.max(hBHB, math.max(ho_i,hc_i))
                            hBLB := na(hBLB) ? math.min(ho_i,hc_i) : math.min(hBLB, math.min(ho_i,hc_i))
                            hBHW := na(hBHW) ? hh_i : math.max(hBHW, hh_i)
                            hBLW := na(hBLW) ? hl_i : math.min(hBLW, hl_i)
                            hBCnt += 1
                            hii   += 1
                        else
                            hGo := false
                    if hBCnt >= 1 and hBCnt <= 3 and hii < hzSize
                        hLego = array.get(hzO, hii)
                        hLegh = array.get(hzH, hii)
                        hLegl = array.get(hzL, hii)
                        hLegc = array.get(hzC, hii)
                        hLegb = math.abs(hLegc - hLego)
                        hLegr = hLegh - hLegl
                        hLegp = hLegr > 0 ? hLegb / hLegr : 0.0
                        hIsRev = (hLgrn and hLegc < hLego) or (hLred and hLegc > hLego)
                        hRatOk = hIsRev ? hLbody >= legoutMinRatio * hLegb : true
                        if hLegb > 0 and hLegp >= excitePct and hRatOk
                            hTSc = 2.0
                            if hLgrn and hLc > hBHB
                                hStr  = hLo > hBHB ? 2.0 : 1.0
                                newDP = hBHB
                                newDD = hLegc < hLego ? math.min(hBLW, math.min(hLegl, hLl)) : math.min(hBLW, hLl)
                                // Walk subsequent (more-recent) bars: check for breach + count tests
                                bool hDemValid = true
                                int  hDemTc    = 0
                                bool hDemWasIn = false
                                if hLegoutIdx > 0
                                    for hChk = hLegoutIdx - 1 to 0
                                        chkL = array.get(hzL, hChk)
                                        if chkL < newDD
                                            hDemValid := false
                                            break
                                        if chkL <= newDP and not hDemWasIn
                                            hDemTc    += 1
                                            hDemWasIn := true
                                        else if chkL > newDP
                                            hDemWasIn := false
                                if hDemValid and hDemTc <= maxHtfZoneTests and (na(htfDP) or newDP > htfDP)
                                    htfDP     := newDP
                                    htfDD     := newDD
                                    htfDBS    := hStr + hTSc
                                    htfDTc    := hDemTc
                                    htfDWasIn := hDemWasIn
                            else if hLred and hLc < hBLB
                                hStr  = hLo < hBLB ? 2.0 : 1.0
                                newSP = hBLB
                                newSD = hLegc > hLego ? math.max(hBHW, math.max(hLegh, hLh)) : math.max(hBHW, hLh)
                                // Walk subsequent (more-recent) bars: check for breach + count tests
                                bool hSupValid = true
                                int  hSupTc    = 0
                                bool hSupWasIn = false
                                if hLegoutIdx > 0
                                    for hChk = hLegoutIdx - 1 to 0
                                        chkH = array.get(hzH, hChk)
                                        if chkH > newSD
                                            hSupValid := false
                                            break
                                        if chkH >= newSP and not hSupWasIn
                                            hSupTc    += 1
                                            hSupWasIn := true
                                        else if chkH < newSP
                                            hSupWasIn := false
                                if hSupValid and hSupTc <= maxHtfZoneTests and (na(htfSP) or newSP < htfSP)
                                    htfSP     := newSP
                                    htfSD     := newSD
                                    htfSBS    := hStr + hTSc
                                    htfSTc    := hSupTc
                                    htfSWasIn := hSupWasIn

                    // ── HTF zero-base path (engulfing spike, no base candles) ──
                    else if allowZeroBase and hBCnt == 0 and hii < hzSize
                        hzLego = array.get(hzO, hii)
                        hzLegh = array.get(hzH, hii)
                        hzLegl = array.get(hzL, hii)
                        hzLegc = array.get(hzC, hii)
                        hzLegb = math.abs(hzLegc - hzLego)
                        hzLegr = hzLegh - hzLegl
                        hzLegp = hzLegr > 0 ? hzLegb / hzLegr : 0.0

                        hzbDem = hzLegc < hzLego and hLgrn
                        hzbSup = hzLegc > hzLego and hLred

                        if (hzbDem or hzbSup) and hzLegp >= excitePct and hzLegb > 0 and hLbody >= legoutMinRatio * hzLegb
                            if hzbDem
                                hzbLeginBdyHigh = math.max(hzLego, hzLegc)
                                newDP           = math.max(math.min(hzLego, hzLegc), hLo)
                                newDD           = math.min(hzLegl, hLl)
                                hzbDemZV = hLc > hzbLeginBdyHigh
                                if hzbDemZV
                                    bool hDemValid = true
                                    int  hDemTc    = 0
                                    bool hDemWasIn = false
                                    if hLegoutIdx > 0
                                        for hChk = hLegoutIdx - 1 to 0
                                            chkL = array.get(hzL, hChk)
                                            if chkL < newDD
                                                hDemValid := false
                                                break
                                            if chkL <= newDP and not hDemWasIn
                                                hDemTc    += 1
                                                hDemWasIn := true
                                            else if chkL > newDP
                                                hDemWasIn := false
                                    hzbDSc = hLo > hzbLeginBdyHigh ? 2.0 : 1.0
                                    if hDemValid and hDemTc <= maxHtfZoneTests and (na(htfDP) or newDP > htfDP)
                                        htfDP     := newDP
                                        htfDD     := newDD
                                        htfDBS    := hzbDSc + 2.0
                                        htfDTc    := hDemTc
                                        htfDWasIn := hDemWasIn
                            else if hzbSup
                                hzbLeginBdyLow = math.min(hzLego, hzLegc)
                                newSP          = math.min(math.max(hzLego, hzLegc), hLo)
                                newSD          = math.max(hzLegh, hLh)
                                hzbSupZV = hLc < hzbLeginBdyLow
                                if hzbSupZV
                                    bool hSupValid = true
                                    int  hSupTc    = 0
                                    bool hSupWasIn = false
                                    if hLegoutIdx > 0
                                        for hChk = hLegoutIdx - 1 to 0
                                            chkH = array.get(hzH, hChk)
                                            if chkH > newSD
                                                hSupValid := false
                                                break
                                            if chkH >= newSP and not hSupWasIn
                                                hSupTc    += 1
                                                hSupWasIn := true
                                            else if chkH < newSP
                                                hSupWasIn := false
                                    hzbSSc = hLo < hzbLeginBdyLow ? 2.0 : 1.0
                                    if hSupValid and hSupTc <= maxHtfZoneTests and (na(htfSP) or newSP < htfSP)
                                        htfSP     := newSP
                                        htfSD     := newSD
                                        htfSBS    := hzbSSc + 2.0
                                        htfSTc    := hSupTc
                                        htfSWasIn := hSupWasIn

    else if not na(htfRunO)
        htfRunH := math.max(htfRunH, high)
        htfRunL := math.min(htfRunL, low)
    else
        htfRunO := open
        htfRunH := high
        htfRunL := low

    // % distance using zone-range as 100%: demPct + supPct = 100 when both exist
    float htfDemDistPct = -999.0
    float htfDemScoreV  = 0.0
    float htfSupDistPct = -999.0
    float htfSupScoreV  = 0.0
    bool htfDemOk     = not na(htfDP) and htfDTc <= maxHtfZoneTests and close > htfDP
    bool htfSupOk     = not na(htfSP) and htfSTc <= maxHtfZoneTests and close < htfSP
    bool htfDemInside = not na(htfDP) and not na(htfDD) and htfDTc <= maxHtfZoneTests and close <= htfDP and close >= htfDD
    bool htfSupInside = not na(htfSP) and not na(htfSD) and htfSTc <= maxHtfZoneTests and close >= htfSP and close <= htfSD
    if htfDemOk and htfSupOk
        zoneRange = htfSP - htfDP
        if zoneRange > 0
            htfDemDistPct := (close - htfDP) / zoneRange * 100.0
            htfSupDistPct := (htfSP - close) / zoneRange * 100.0
        htfDFSc = htfDTc == 0 ? 3.0 : htfDTc == 1 ? 1.5 : 0.0
        htfSFSc = htfSTc == 0 ? 3.0 : htfSTc == 1 ? 1.5 : 0.0
        htfDemScoreV := htfDFSc + htfDBS
        htfSupScoreV := htfSFSc + htfSBS
    else if htfDemOk
        htfDFSc = htfDTc == 0 ? 3.0 : htfDTc == 1 ? 1.5 : 0.0
        htfDemDistPct := (close - htfDP) / close * 100.0
        htfDemScoreV  := htfDFSc + htfDBS
    else if htfSupOk
        htfSFSc = htfSTc == 0 ? 3.0 : htfSTc == 1 ? 1.5 : 0.0
        htfSupDistPct := (htfSP - close) / close * 100.0
        htfSupScoreV  := htfSFSc + htfSBS
    // -1.0 sentinel: price is currently inside this HTF zone
    if htfDemInside
        htfDemDistPct := -1.0
        htfDemScoreV  := (htfDTc == 0 ? 3.0 : htfDTc == 1 ? 1.5 : 0.0) + htfDBS
    if htfSupInside
        htfSupDistPct := -1.0
        htfSupScoreV  := (htfSTc == 0 ? 3.0 : htfSTc == 1 ? 1.5 : 0.0) + htfSBS


    float bestDP = na
    float bestDD = na
    float bestSP = na
    float bestSD = na
    float bestDS = 0.0
    float bestSS = 0.0

    for startBar = 1 to lookbackBars
        lOut_o    = open[startBar]
        lOut_h    = high[startBar]
        lOut_l    = low[startBar]
        lOut_c    = close[startBar]
        lOut_body = math.abs(lOut_c - lOut_o)
        lOut_rng  = lOut_h - lOut_l
        lOut_bPct = lOut_rng > 0 ? lOut_body / lOut_rng : 0.0
        lOut_grn  = lOut_c > lOut_o
        lOut_red  = lOut_c < lOut_o
        // Post-legout candle (bar immediately after legout) for 2-exciting check
        nxt_body  = math.abs(close[startBar - 1] - open[startBar - 1])
        nxt_rng   = high[startBar - 1] - low[startBar - 1]
        nxt_bPct  = nxt_rng > 0 ? nxt_body / nxt_rng : 0.0

        if lOut_bPct >= excitePct and lOut_body > 0 and (lOut_grn or lOut_red)
            baseCnt = 0
            ii      = startBar + 1
            float bHB = na
            float bLB = na
            float bHW = na
            float bLW = na
            bool  going = true

            while going and baseCnt < maxBase and ii <= startBar + maxBase + 1
                c_o    = open[ii]
                c_h    = high[ii]
                c_l    = low[ii]
                c_c    = close[ii]
                c_body = math.abs(c_c - c_o)
                c_rng  = c_h - c_l
                c_bPct = c_rng > 0 ? c_body / c_rng : 0.0

                // Standard base check + small-body override (mirrors zones.pine)
                qualStd = c_bPct < basePct
                qualOvr = false
                if not qualStd and allowSmallBodyOverride
                    candLeginBody = math.abs(close[ii + 1] - open[ii + 1])
                    if candLeginBody > 0 and lOut_body > 0
                        if c_body < smallBodyVsLegout * lOut_body and c_body < smallBodyVsLegin * candLeginBody
                            qualOvr := true

                if qualStd or qualOvr
                    bH   = math.max(c_o, c_c)
                    bL   = math.min(c_o, c_c)
                    bHB := na(bHB) ? bH : math.max(bHB, bH)
                    bLB := na(bLB) ? bL : math.min(bLB, bL)
                    bHW := na(bHW) ? c_h : math.max(bHW, c_h)
                    bLW := na(bLW) ? c_l : math.min(bLW, c_l)
                    baseCnt += 1
                    ii      += 1
                else
                    going := false

            // Confirmation close: bar immediately after the legout.
            // startBar=1 -> close[0]=current close; startBar=2 -> close[1], etc.
            confirmClose = close[startBar - 1]

            // ── Standard zone path (≥1 base candle) ─────────────────────────
            if baseCnt >= 1 and baseCnt <= maxBase
                leg_o    = open[ii]
                leg_h    = high[ii]
                leg_l    = low[ii]
                leg_c    = close[ii]
                leg_body = math.abs(leg_c - leg_o)
                leg_rng  = leg_h - leg_l
                leg_bPct = leg_rng > 0 ? leg_body / leg_rng : 0.0

                leginIsRed = leg_c < leg_o
                leginIsGrn = leg_c > leg_o
                isReversal = (lOut_grn and leginIsRed) or (lOut_red and leginIsGrn)
                ratioOk    = isReversal ? lOut_body >= legoutMinRatio * leg_body : true

                if leg_bPct >= excitePct and leg_body > 0 and ratioOk

                    // ── DEMAND (green legout = DBR / RBR) ───────────────────
                    if lOut_grn
                        prox = bHB
                        dist = leginIsRed ? math.min(bLW, math.min(leg_l, lOut_l)) : math.min(bLW, lOut_l)
                        // Immediate close OR confirmation candle closes beyond proximal
                        zoneValid = lOut_c > bHB or confirmClose > bHB

                        if not na(prox) and not na(dist) and zoneValid and close > prox
                            dPct   = (close - prox) / close * 100.0
                            tScore = baseCnt <= 3 ? 2 : baseCnt <= 5 ? 1 : 0
                            isGap  = lOut_o > bHB
                            sScore = isGap ? 2 : nxt_bPct >= excitePct ? 2 : 1

                            int  demTc    = 0
                            bool demWasIn = false
                            bool demInv   = false
                            int  vBar     = startBar - 1
                            while vBar >= 0
                                vLow = low[vBar]
                                if vLow < dist
                                    demInv := true
                                    break
                                vIsIn = vLow <= prox
                                if vIsIn and not demWasIn
                                    demTc += 1
                                demWasIn := vIsIn
                                vBar -= 1

                            if not demInv and demTc <= maxZoneTests
                                fScore = demTc == 0 ? 3.0 : demTc == 1 ? 1.5 : 0.0
                                sc     = fScore + sScore + tScore
                                curBestPct = na(bestDP) ? 999.0 : (close - bestDP) / close * 100.0
                                if dPct < curBestPct
                                    bestDP := prox
                                    bestDD := dist
                                    bestDS := sc

                    // ── SUPPLY (red legout = RBD / DBD) ─────────────────────
                    else if lOut_red
                        prox = bLB
                        dist = leginIsGrn ? math.max(bHW, math.max(leg_h, lOut_h)) : math.max(bHW, lOut_h)
                        zoneValid  = lOut_c < bLB or confirmClose < bLB

                        if not na(prox) and not na(dist) and zoneValid and close < prox
                            dPct   = (prox - close) / close * 100.0
                            tScore = baseCnt <= 3 ? 2 : baseCnt <= 5 ? 1 : 0
                            isGap  = lOut_o < bLB
                            sScore = isGap ? 2 : nxt_bPct >= excitePct ? 2 : 1

                            int  supTc    = 0
                            bool supWasIn = false
                            bool supInv   = false
                            int  vBar     = startBar - 1
                            while vBar >= 0
                                vHigh = high[vBar]
                                if vHigh > dist
                                    supInv := true
                                    break
                                vIsIn = vHigh >= prox
                                if vIsIn and not supWasIn
                                    supTc += 1
                                supWasIn := vIsIn
                                vBar -= 1

                            if not supInv and supTc <= maxZoneTests
                                fScore = supTc == 0 ? 3.0 : supTc == 1 ? 1.5 : 0.0
                                sc     = fScore + sScore + tScore
                                curBestPct = na(bestSP) ? 999.0 : (bestSP - close) / close * 100.0
                                if dPct < curBestPct
                                    bestSP := prox
                                    bestSD := dist
                                    bestSS := sc

            // ── Zero-base path (engulfing spike reversal, no base candles) ──
            else if allowZeroBase and baseCnt == 0
                leg2_o    = open[startBar + 1]
                leg2_h    = high[startBar + 1]
                leg2_l    = low[startBar + 1]
                leg2_c    = close[startBar + 1]
                leg2_body = math.abs(leg2_c - leg2_o)
                leg2_rng  = leg2_h - leg2_l
                leg2_bPct = leg2_rng > 0 ? leg2_body / leg2_rng : 0.0

                zbDemand = leg2_c < leg2_o and lOut_grn  // red legin → green legout
                zbSupply = leg2_c > leg2_o and lOut_red  // green legin → red legout

                if (zbDemand or zbSupply) and leg2_bPct >= excitePct and leg2_body > 0 and lOut_body >= legoutMinRatio * leg2_body

                    if zbDemand
                        prox = math.max(math.min(leg2_o, leg2_c), lOut_o)
                        dist = math.min(leg2_l, lOut_l)
                        leginBdyHigh = math.max(leg2_o, leg2_c)
                        zoneValid    = lOut_c > leginBdyHigh or confirmClose > leginBdyHigh

                        if not na(prox) and not na(dist) and zoneValid and close > prox
                            dPct   = (close - prox) / close * 100.0
                            isGap  = lOut_o > leginBdyHigh
                            sScore = isGap ? 2 : nxt_bPct >= excitePct ? 2 : 1

                            int  demTc    = 0
                            bool demWasIn = false
                            bool demInv   = false
                            int  vBar     = startBar - 1
                            while vBar >= 0
                                vLow = low[vBar]
                                if vLow < dist
                                    demInv := true
                                    break
                                vIsIn = vLow <= prox
                                if vIsIn and not demWasIn
                                    demTc += 1
                                demWasIn := vIsIn
                                vBar -= 1

                            if not demInv and demTc <= maxZoneTests
                                fScore = demTc == 0 ? 3.0 : demTc == 1 ? 1.5 : 0.0
                                sc     = fScore + sScore + 2.0  // baseCnt=0 → tScore=2
                                curBestPct = na(bestDP) ? 999.0 : (close - bestDP) / close * 100.0
                                if dPct < curBestPct
                                    bestDP := prox
                                    bestDD := dist
                                    bestDS := sc

                    else
                        prox = math.min(math.max(leg2_o, leg2_c), lOut_o)
                        dist = math.max(leg2_h, lOut_h)
                        leginBdyLow = math.min(leg2_o, leg2_c)
                        zoneValid   = lOut_c < leginBdyLow or confirmClose < leginBdyLow

                        if not na(prox) and not na(dist) and zoneValid and close < prox
                            dPct   = (prox - close) / close * 100.0
                            isGap  = lOut_o < leginBdyLow
                            sScore = isGap ? 2 : nxt_bPct >= excitePct ? 2 : 1

                            int  supTc    = 0
                            bool supWasIn = false
                            bool supInv   = false
                            int  vBar     = startBar - 1
                            while vBar >= 0
                                vHigh = high[vBar]
                                if vHigh > dist
                                    supInv := true
                                    break
                                vIsIn = vHigh >= prox
                                if vIsIn and not supWasIn
                                    supTc += 1
                                supWasIn := vIsIn
                                vBar -= 1

                            if not supInv and supTc <= maxZoneTests
                                fScore = supTc == 0 ? 3.0 : supTc == 1 ? 1.5 : 0.0
                                sc     = fScore + sScore + 2.0  // baseCnt=0 → tScore=2
                                curBestPct = na(bestSP) ? 999.0 : (bestSP - close) / close * 100.0
                                if dPct < curBestPct
                                    bestSP := prox
                                    bestSD := dist
                                    bestSS := sc

    float demDistPct = na(bestDP) ? -999.0 : (close - bestDP) / close * 100.0
    float supDistPct = na(bestSP) ? -999.0 : (bestSP - close) / close * 100.0

    [demDistPct, bestDP, bestDD, bestDS,
     supDistPct, bestSP, bestSD, bestSS, float(trendDir), float(htfTrendDir),
     htfDemDistPct, htfDemScoreV, htfSupDistPct, htfSupScoreV]

// =============================================================================
// FETCH ZONE DATA FOR ALL 40 STOCKS
// Each call returns a 9-tuple at the current chart timeframe.
// =============================================================================
[dd01,dp01,ddi01,ds01, sd01,sp01,sdi01,ss01,tr01,ht01,hdd01,hdds01,hsd01,hsds01] = request.security(sym01, timeframe.period, f_scanZones(), lookahead = barmerge.lookahead_off)
[dd02,dp02,ddi02,ds02, sd02,sp02,sdi02,ss02,tr02,ht02,hdd02,hdds02,hsd02,hsds02] = request.security(sym02, timeframe.period, f_scanZones(), lookahead = barmerge.lookahead_off)
[dd03,dp03,ddi03,ds03, sd03,sp03,sdi03,ss03,tr03,ht03,hdd03,hdds03,hsd03,hsds03] = request.security(sym03, timeframe.period, f_scanZones(), lookahead = barmerge.lookahead_off)
[dd04,dp04,ddi04,ds04, sd04,sp04,sdi04,ss04,tr04,ht04,hdd04,hdds04,hsd04,hsds04] = request.security(sym04, timeframe.period, f_scanZones(), lookahead = barmerge.lookahead_off)
[dd05,dp05,ddi05,ds05, sd05,sp05,sdi05,ss05,tr05,ht05,hdd05,hdds05,hsd05,hsds05] = request.security(sym05, timeframe.period, f_scanZones(), lookahead = barmerge.lookahead_off)
[dd06,dp06,ddi06,ds06, sd06,sp06,sdi06,ss06,tr06,ht06,hdd06,hdds06,hsd06,hsds06] = request.security(sym06, timeframe.period, f_scanZones(), lookahead = barmerge.lookahead_off)
[dd07,dp07,ddi07,ds07, sd07,sp07,sdi07,ss07,tr07,ht07,hdd07,hdds07,hsd07,hsds07] = request.security(sym07, timeframe.period, f_scanZones(), lookahead = barmerge.lookahead_off)
[dd08,dp08,ddi08,ds08, sd08,sp08,sdi08,ss08,tr08,ht08,hdd08,hdds08,hsd08,hsds08] = request.security(sym08, timeframe.period, f_scanZones(), lookahead = barmerge.lookahead_off)
[dd09,dp09,ddi09,ds09, sd09,sp09,sdi09,ss09,tr09,ht09,hdd09,hdds09,hsd09,hsds09] = request.security(sym09, timeframe.period, f_scanZones(), lookahead = barmerge.lookahead_off)
[dd10,dp10,ddi10,ds10, sd10,sp10,sdi10,ss10,tr10,ht10,hdd10,hdds10,hsd10,hsds10] = request.security(sym10, timeframe.period, f_scanZones(), lookahead = barmerge.lookahead_off)
[dd11,dp11,ddi11,ds11, sd11,sp11,sdi11,ss11,tr11,ht11,hdd11,hdds11,hsd11,hsds11] = request.security(sym11, timeframe.period, f_scanZones(), lookahead = barmerge.lookahead_off)
[dd12,dp12,ddi12,ds12, sd12,sp12,sdi12,ss12,tr12,ht12,hdd12,hdds12,hsd12,hsds12] = request.security(sym12, timeframe.period, f_scanZones(), lookahead = barmerge.lookahead_off)
[dd13,dp13,ddi13,ds13, sd13,sp13,sdi13,ss13,tr13,ht13,hdd13,hdds13,hsd13,hsds13] = request.security(sym13, timeframe.period, f_scanZones(), lookahead = barmerge.lookahead_off)
[dd14,dp14,ddi14,ds14, sd14,sp14,sdi14,ss14,tr14,ht14,hdd14,hdds14,hsd14,hsds14] = request.security(sym14, timeframe.period, f_scanZones(), lookahead = barmerge.lookahead_off)
[dd15,dp15,ddi15,ds15, sd15,sp15,sdi15,ss15,tr15,ht15,hdd15,hdds15,hsd15,hsds15] = request.security(sym15, timeframe.period, f_scanZones(), lookahead = barmerge.lookahead_off)
[dd16,dp16,ddi16,ds16, sd16,sp16,sdi16,ss16,tr16,ht16,hdd16,hdds16,hsd16,hsds16] = request.security(sym16, timeframe.period, f_scanZones(), lookahead = barmerge.lookahead_off)
