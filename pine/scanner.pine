[dd33,dp33,ddi33,ds33, sd33,sp33,sdi33,ss33,tr33,ht33,hdd33,hdds33,hsd33,hsds33] = request.security(sym33, timeframe.period, f_scanZones(), lookahead = barmerge.lookahead_off)
