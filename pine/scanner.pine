[dd38,dp38,ddi38,ds38, sd38,sp38,sdi38,ss38,tr38,ht38,hdd38,hdds38,hsd38,hsds38] = request.security(sym38, timeframe.period, f_scanZones(), lookahead = barmerge.lookahead_off)
