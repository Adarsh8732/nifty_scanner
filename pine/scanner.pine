// =============================================================================
// PACK DATA INTO ARRAYS FOR PROCESSING
// =============================================================================
// Arrays: [sym, demDistPct, demProx, demDist, demScore,
//           supDistPct, supProx, supDist, supScore, trendDir]

var string[] syms  = array.from(sym01,sym02,sym03,sym04,sym05,sym06,sym07,sym08,sym09,sym10,sym11,sym12,sym13,sym14,sym15,sym16,sym17,sym18,sym19,sym20,sym21,sym22,sym23,sym24,sym25,sym26,sym27,sym28,sym29,sym30,sym31,sym32,sym33,sym34,sym35,sym36,sym37,sym38,sym39,sym40)

// Track previous in-zone state per stock (for entry-edge alert detection)
var bool[] prevInDem = array.new_bool(40, false)
var bool[] prevInSup = array.new_bool(40, false)

// Assemble per-stock result arrays on last bar
f_arr40(v01,v02,v03,v04,v05,v06,v07,v08,v09,v10,v11,v12,v13,v14,v15,v16,v17,v18,v19,v20,v21,v22,v23,v24,v25,v26,v27,v28,v29,v30,v31,v32,v33,v34,v35,v36,v37,v38,v39,v40) =>
    array.from(v01,v02,v03,v04,v05,v06,v07,v08,v09,v10,v11,v12,v13,v14,v15,v16,v17,v18,v19,v20,v21,v22,v23,v24,v25,v26,v27,v28,v29,v30,v31,v32,v33,v34,v35,v36,v37,v38,v39,v40)

// =============================================================================
// TABLE BUILDING
// =============================================================================
f_fmtPct(v) =>
    str.tostring(math.round(v * 10) / 10) + "%"

f_fmtPrice(v) =>
    str.tostring(math.round(v * 100) / 100)

f_trendTxt(t) =>
    t == 1 ? "↑ Up" : t == -1 ? "↓ Down" : "→ Side"

f_trendColor(t) =>
    t == 1 ? color.new(color.green, 30) : t == -1 ? color.new(color.red, 30) : color.new(color.gray, 40)

f_fillTblRow(tbl, row, sym_s, zType, distPct, prox, dist2, score, htfTrendV, htfDemD, htfDemSc, htfSupD, htfSupSc) =>
    zoneTxt   = zType == 1 ? "🟢 Demand" : "🔴 Supply"
    zoneColor = zType == 1 ? color.new(color.green, 40) : color.new(color.red, 40)
    // bufAmt    = prox * bufferPct / 100.0
    // float entry  = na
    // float sl     = na
    // float target = na
    // if zType == 1
        // entry  := prox + bufAmt
        // sl     := dist2 - bufAmt
        // target := entry + rrRatio * (entry - sl)
    // else
        // entry  := prox - bufAmt
        // sl     := dist2 + bufAmt
        // target := entry - rrRatio * (sl - entry)
    htfDemNear = htfDemD == -1.0 or (htfDemD > 0.0 and htfDemD <= 40.0)
    htfSupNear = htfSupD == -1.0 or (htfSupD > 0.0 and htfSupD <= 40.0)
    isGreenRow = zType == 1  and int(htfTrendV) == 1  and htfDemNear
    isRedRow   = zType == -1 and int(htfTrendV) == -1 and htfSupNear
    rowBg = isGreenRow ? color.new(color.green, 50) : isRedRow ? color.new(color.red, 50) : color.new(color.gray, 60)
    table.cell(tbl, 0, row, sym_s,               text_color = color.white,  text_size = size.small, bgcolor = rowBg)
    table.cell(tbl, 1, row, zoneTxt,             text_color = color.white,  text_size = size.small, bgcolor = zoneColor)
    table.cell(tbl, 2, row, f_fmtPct(distPct),  text_color = color.yellow, text_size = size.small, bgcolor = rowBg)
    table.cell(tbl, 3, row, str.tostring(score), text_color = color.white,  text_size = size.small, bgcolor = rowBg)
    table.cell(tbl, 4, row, f_trendTxt(int(htfTrendV)), text_color = color.white, text_size = size.small, bgcolor = f_trendColor(int(htfTrendV)))
    htfDemTxt = htfDemD > 0.0 ? str.tostring(math.round(htfDemD)) + "% / " + str.tostring(math.round(htfDemSc * 10) / 10) : "-"
    htfSupTxt = htfSupD > 0.0 ? str.tostring(math.round(htfSupD)) + "% / " + str.tostring(math.round(htfSupSc * 10) / 10) : "-"
    htfDemBg  = htfDemD == -1.0 ? color.new(color.green, 40) : htfDemD > 0.0 ? (htfDemD < 40.0 ? color.new(color.green, 40) : color.new(color.red, 40)) : color.new(color.gray, 60)
    htfSupBg  = htfSupD == -1.0 ? color.new(color.green, 40) : htfSupD > 0.0 ? (htfSupD < 40.0 ? color.new(color.green, 40) : color.new(color.red, 40)) : color.new(color.gray, 60)
    table.cell(tbl, 5, row, htfDemTxt,  text_color = color.white, text_size = size.small, bgcolor = htfDemBg)
    table.cell(tbl, 6, row, htfSupTxt,  text_color = color.white, text_size = size.small, bgcolor = htfSupBg)
    // In MTF: show which zone price is inside (-1.0), or which is nearest when outside both
    bool _bothIn  = htfDemD == -1.0 and htfSupD == -1.0
    bool _demIn   = htfDemD == -1.0 and htfSupD != -1.0
    bool _supIn   = htfSupD == -1.0 and htfDemD != -1.0
    bool _demNear = htfDemD > 0.0 and htfSupD > 0.0 and htfDemD < htfSupD
    bool _supNear = htfDemD > 0.0 and htfSupD > 0.0 and htfSupD <= htfDemD
    bool _onlyDem = htfDemD > 0.0 and not (htfSupD > 0.0)
    bool _onlySup = htfSupD > 0.0 and not (htfDemD > 0.0)
    inZoneTxt = _bothIn ? "D+S" : _demIn ? "inD" : _supIn ? "inS" : _demNear ? "↓Dem" : _supNear ? "↑Sup" : _onlyDem ? "Dem" : _onlySup ? "Sup" : "-"
    inZoneBg  = _bothIn ? color.new(color.orange, 40) : _demIn ? color.new(color.green, 40) : _supIn ? color.new(color.red, 40) : _demNear ? color.new(color.green, 60) : _supNear ? color.new(color.red, 60) : color.new(color.gray, 60)
    table.cell(tbl, 7, row, inZoneTxt,  text_color = color.white, text_size = size.small, bgcolor = inZoneBg)
    // if showEntry
        // table.cell(tbl, 5, row, f_fmtPrice(entry) + " / " + f_fmtPrice(sl),  text_color = color.white,                text_size = size.small, bgcolor = rowBg)
        // table.cell(tbl, 6, row, f_fmtPrice(target),                           text_color = color.new(color.green, 10), text_size = size.small, bgcolor = rowBg)

f_addHeader(tbl) =>
    headerBg = color.new(color.navy, 20)
    table.cell(tbl, 0, 0, "Symbol",      text_color = color.white, text_size = size.small, bgcolor = headerBg)
    table.cell(tbl, 1, 0, "Zone",        text_color = color.white, text_size = size.small, bgcolor = headerBg)
    table.cell(tbl, 2, 0, "% Away",      text_color = color.white, text_size = size.small, bgcolor = headerBg)
    table.cell(tbl, 3, 0, "Score",       text_color = color.white, text_size = size.small, bgcolor = headerBg)
    table.cell(tbl, 4, 0, "HTF Trend",   text_color = color.white, text_size = size.small, bgcolor = headerBg)
    table.cell(tbl, 5, 0, "HTF Dem",     text_color = color.white, text_size = size.small, bgcolor = headerBg)
    table.cell(tbl, 6, 0, "HTF Sup",     text_color = color.white, text_size = size.small, bgcolor = headerBg)
    table.cell(tbl, 7, 0, "In MTF",      text_color = color.white, text_size = size.small, bgcolor = headerBg)
    // if showEntry
        // table.cell(tbl, 5, 0, "Entry / SL", text_color = color.white, text_size = size.small, bgcolor = headerBg)
        // table.cell(tbl, 6, 0, "Target",     text_color = color.white, text_size = size.small, bgcolor = headerBg)

var table tbl1 = na
var table tbl2 = na
var table tbl3 = na

if barstate.islast
    if not na(tbl1)
        table.delete(tbl1)
    if not na(tbl2)
        table.delete(tbl2)
    if not na(tbl3)
        table.delete(tbl3)

    // Assemble data arrays
    demDists  = f_arr40(dd01,dd02,dd03,dd04,dd05,dd06,dd07,dd08,dd09,dd10,dd11,dd12,dd13,dd14,dd15,dd16,dd17,dd18,dd19,dd20,dd21,dd22,dd23,dd24,dd25,dd26,dd27,dd28,dd29,dd30,dd31,dd32,dd33,dd34,dd35,dd36,dd37,dd38,dd39,dd40)
    demProxs  = f_arr40(dp01,dp02,dp03,dp04,dp05,dp06,dp07,dp08,dp09,dp10,dp11,dp12,dp13,dp14,dp15,dp16,dp17,dp18,dp19,dp20,dp21,dp22,dp23,dp24,dp25,dp26,dp27,dp28,dp29,dp30,dp31,dp32,dp33,dp34,dp35,dp36,dp37,dp38,dp39,dp40)
    demDists2 = f_arr40(ddi01,ddi02,ddi03,ddi04,ddi05,ddi06,ddi07,ddi08,ddi09,ddi10,ddi11,ddi12,ddi13,ddi14,ddi15,ddi16,ddi17,ddi18,ddi19,ddi20,ddi21,ddi22,ddi23,ddi24,ddi25,ddi26,ddi27,ddi28,ddi29,ddi30,ddi31,ddi32,ddi33,ddi34,ddi35,ddi36,ddi37,ddi38,ddi39,ddi40)
    demScores = f_arr40(ds01,ds02,ds03,ds04,ds05,ds06,ds07,ds08,ds09,ds10,ds11,ds12,ds13,ds14,ds15,ds16,ds17,ds18,ds19,ds20,ds21,ds22,ds23,ds24,ds25,ds26,ds27,ds28,ds29,ds30,ds31,ds32,ds33,ds34,ds35,ds36,ds37,ds38,ds39,ds40)
    supDists  = f_arr40(sd01,sd02,sd03,sd04,sd05,sd06,sd07,sd08,sd09,sd10,sd11,sd12,sd13,sd14,sd15,sd16,sd17,sd18,sd19,sd20,sd21,sd22,sd23,sd24,sd25,sd26,sd27,sd28,sd29,sd30,sd31,sd32,sd33,sd34,sd35,sd36,sd37,sd38,sd39,sd40)
    supProxs  = f_arr40(sp01,sp02,sp03,sp04,sp05,sp06,sp07,sp08,sp09,sp10,sp11,sp12,sp13,sp14,sp15,sp16,sp17,sp18,sp19,sp20,sp21,sp22,sp23,sp24,sp25,sp26,sp27,sp28,sp29,sp30,sp31,sp32,sp33,sp34,sp35,sp36,sp37,sp38,sp39,sp40)
    supDists2 = f_arr40(sdi01,sdi02,sdi03,sdi04,sdi05,sdi06,sdi07,sdi08,sdi09,sdi10,sdi11,sdi12,sdi13,sdi14,sdi15,sdi16,sdi17,sdi18,sdi19,sdi20,sdi21,sdi22,sdi23,sdi24,sdi25,sdi26,sdi27,sdi28,sdi29,sdi30,sdi31,sdi32,sdi33,sdi34,sdi35,sdi36,sdi37,sdi38,sdi39,sdi40)
    supScores = f_arr40(ss01,ss02,ss03,ss04,ss05,ss06,ss07,ss08,ss09,ss10,ss11,ss12,ss13,ss14,ss15,ss16,ss17,ss18,ss19,ss20,ss21,ss22,ss23,ss24,ss25,ss26,ss27,ss28,ss29,ss30,ss31,ss32,ss33,ss34,ss35,ss36,ss37,ss38,ss39,ss40)
    trends    = f_arr40(tr01,tr02,tr03,tr04,tr05,tr06,tr07,tr08,tr09,tr10,tr11,tr12,tr13,tr14,tr15,tr16,tr17,tr18,tr19,tr20,tr21,tr22,tr23,tr24,tr25,tr26,tr27,tr28,tr29,tr30,tr31,tr32,tr33,tr34,tr35,tr36,tr37,tr38,tr39,tr40)
    htfTrends = f_arr40(ht01,ht02,ht03,ht04,ht05,ht06,ht07,ht08,ht09,ht10,ht11,ht12,ht13,ht14,ht15,ht16,ht17,ht18,ht19,ht20,ht21,ht22,ht23,ht24,ht25,ht26,ht27,ht28,ht29,ht30,ht31,ht32,ht33,ht34,ht35,ht36,ht37,ht38,ht39,ht40)
    htfDemDists  = f_arr40(hdd01,hdd02,hdd03,hdd04,hdd05,hdd06,hdd07,hdd08,hdd09,hdd10,hdd11,hdd12,hdd13,hdd14,hdd15,hdd16,hdd17,hdd18,hdd19,hdd20,hdd21,hdd22,hdd23,hdd24,hdd25,hdd26,hdd27,hdd28,hdd29,hdd30,hdd31,hdd32,hdd33,hdd34,hdd35,hdd36,hdd37,hdd38,hdd39,hdd40)
    htfDemScores = f_arr40(hdds01,hdds02,hdds03,hdds04,hdds05,hdds06,hdds07,hdds08,hdds09,hdds10,hdds11,hdds12,hdds13,hdds14,hdds15,hdds16,hdds17,hdds18,hdds19,hdds20,hdds21,hdds22,hdds23,hdds24,hdds25,hdds26,hdds27,hdds28,hdds29,hdds30,hdds31,hdds32,hdds33,hdds34,hdds35,hdds36,hdds37,hdds38,hdds39,hdds40)
    htfSupDists  = f_arr40(hsd01,hsd02,hsd03,hsd04,hsd05,hsd06,hsd07,hsd08,hsd09,hsd10,hsd11,hsd12,hsd13,hsd14,hsd15,hsd16,hsd17,hsd18,hsd19,hsd20,hsd21,hsd22,hsd23,hsd24,hsd25,hsd26,hsd27,hsd28,hsd29,hsd30,hsd31,hsd32,hsd33,hsd34,hsd35,hsd36,hsd37,hsd38,hsd39,hsd40)
    htfSupScores = f_arr40(hsds01,hsds02,hsds03,hsds04,hsds05,hsds06,hsds07,hsds08,hsds09,hsds10,hsds11,hsds12,hsds13,hsds14,hsds15,hsds16,hsds17,hsds18,hsds19,hsds20,hsds21,hsds22,hsds23,hsds24,hsds25,hsds26,hsds27,hsds28,hsds29,hsds30,hsds31,hsds32,hsds33,hsds34,hsds35,hsds36,hsds37,hsds38,hsds39,hsds40)

    // --- Collect qualifying rows ---
    // Each match: [symIdx, zoneType (1=D/-1=S), distPct, prox, dist, score, trend]
    var array<int>   rIdx   = array.new<int>()
    var array<int>   rType  = array.new<int>()
    var array<float> rDist  = array.new<float>()
    var array<float> rProx  = array.new<float>()
    var array<float> rDist2 = array.new<float>()
    var array<float> rScore = array.new<float>()
    var array<float> rTrend       = array.new<float>()
    var array<float> rHtfTrend    = array.new<float>()
    var array<float> rHtfDemDist  = array.new<float>()
    var array<float> rHtfDemScore = array.new<float>()
    var array<float> rHtfSupDist  = array.new<float>()
    var array<float> rHtfSupScore = array.new<float>()

    array.clear(rIdx)
    array.clear(rType)
    array.clear(rDist)
    array.clear(rProx)
    array.clear(rDist2)
    array.clear(rScore)
    array.clear(rTrend)
    array.clear(rHtfTrend)
    array.clear(rHtfDemDist)
    array.clear(rHtfDemScore)
    array.clear(rHtfSupDist)
    array.clear(rHtfSupScore)

    for i = 0 to 39
        trendVal = array.get(trends, i)

        // --- Check demand ---
        if scanMode != "Supply only"
            dPct   = array.get(demDists,  i)
            dProx  = array.get(demProxs,  i)
            dDist  = array.get(demDists2, i)
            dScore = array.get(demScores, i)

            passRange  = dPct >= minDistPct and dPct <= maxDistPct
            passTrend  = not useTrendFilter  or trendVal == 1
            passScore  = not useScoreFilter  or dScore >= minScore
            passZone   = dPct > -999.0

            // --- Alert: price has crossed below the entry line (transition outside -> inside) ---
            // Entry line = proximal + alertEntryPct% (sits ABOVE the proximal for demand).
            // dPct <= alertEntryPct means close <= prox * (1 + alertEntryPct/100), i.e.
            // price is at or below the entry line = approaching the demand zone.
            // Restricted to Daily and Weekly chart timeframes.
            bool alertTfOk = timeframe.isdaily or timeframe.isweekly
            inDemNow = passZone and dPct <= alertEntryPct
            wasInDem = array.get(prevInDem, i)
            if enableAlerts and alertTfOk and alertDemand and inDemNow and not wasInDem
                scoreOk = dScore >= alertMinScore
                trendOk = not alertOnlyQualified or passTrend

                // Strict filter (port of Python passes_strict_filter):
                //   HTF trend = Up AND price closer to HTF Demand than HTF Supply
                //   (or HTF Supply doesn't exist).
                //   -1.0  = price is INSIDE that HTF zone (most favorable)
                //   -999.0 = no HTF zone of that type
                htfTrendV_d = array.get(htfTrends,   i)
                htfDemD_d   = array.get(htfDemDists, i)
                htfSupD_d   = array.get(htfSupDists, i)
                bool htfTrendUp = int(htfTrendV_d) == 1
                bool demExists  = htfDemD_d == -1.0 or htfDemD_d > 0.0
                bool supExists  = htfSupD_d == -1.0 or htfSupD_d > 0.0
                bool demCloser  = htfDemD_d == -1.0 or (htfSupD_d != -1.0 and (not supExists or htfDemD_d < htfSupD_d))
                bool strictOk   = not useStrictFilter or (htfTrendUp and demExists and demCloser)

                if scoreOk and trendOk and strictOk
                    symStr = array.get(syms, i)
                    msg = symStr + " APPROACHING DEMAND zone | prox: " + str.tostring(math.round(dProx * 100) / 100) + " | score: " + str.tostring(math.round(dScore * 10) / 10)
                    alert(msg, alert.freq_once_per_bar)
            array.set(prevInDem, i, inDemNow)

            if passZone and passRange and passTrend and passScore
                array.push(rIdx,   i)
                array.push(rType,  1)
                array.push(rDist,  dPct)
                array.push(rProx,  dProx)
                array.push(rDist2, dDist)
                array.push(rScore, dScore)
                array.push(rTrend,       trendVal)
                array.push(rHtfTrend,    array.get(htfTrends,    i))
                array.push(rHtfDemDist,  array.get(htfDemDists,  i))
                array.push(rHtfDemScore, array.get(htfDemScores, i))
                array.push(rHtfSupDist,  array.get(htfSupDists,  i))
                array.push(rHtfSupScore, array.get(htfSupScores, i))

        // --- Check supply ---
        if scanMode != "Demand only"
            sPct   = array.get(supDists,  i)
            sProx  = array.get(supProxs,  i)
            sDist  = array.get(supDists2, i)
            sScore = array.get(supScores, i)

            passRange  = sPct >= minDistPct and sPct <= maxDistPct
            passTrend  = not useTrendFilter  or trendVal == -1
            passScore  = not useScoreFilter  or sScore >= minScore
            passZone   = sPct > -999.0

            // --- Alert: price has crossed above the entry line (transition outside -> inside) ---
            // Entry line = proximal - alertEntryPct% (sits BELOW the proximal for supply).
            // sPct <= alertEntryPct means close >= prox * (1 - alertEntryPct/100), i.e.
            // price is at or above the entry line = approaching the supply zone.
            // Restricted to Daily and Weekly chart timeframes.
            bool alertTfOk = timeframe.isdaily or timeframe.isweekly
            inSupNow = passZone and sPct <= alertEntryPct
            wasInSup = array.get(prevInSup, i)
            if enableAlerts and alertTfOk and alertSupply and inSupNow and not wasInSup
                scoreOk = sScore >= alertMinScore
                trendOk = not alertOnlyQualified or passTrend

                // Strict filter (mirror of demand): HTF trend = Down AND price
                // closer to HTF Supply than HTF Demand (or no HTF Demand).
                htfTrendV_s = array.get(htfTrends,   i)
                htfDemD_s   = array.get(htfDemDists, i)
                htfSupD_s   = array.get(htfSupDists, i)
                bool htfTrendDn  = int(htfTrendV_s) == -1
                bool sDemExists  = htfDemD_s == -1.0 or htfDemD_s > 0.0
                bool sSupExists2 = htfSupD_s == -1.0 or htfSupD_s > 0.0
                bool supCloser   = htfSupD_s == -1.0 or (htfDemD_s != -1.0 and (not sDemExists or htfSupD_s < htfDemD_s))
                bool strictOk_s  = not useStrictFilter or (htfTrendDn and sSupExists2 and supCloser)

                if scoreOk and trendOk and strictOk_s
                    symStr = array.get(syms, i)
                    msg = symStr + " APPROACHING SUPPLY zone | prox: " + str.tostring(math.round(sProx * 100) / 100) + " | score: " + str.tostring(math.round(sScore * 10) / 10)
                    alert(msg, alert.freq_once_per_bar)
            array.set(prevInSup, i, inSupNow)

            if passZone and passRange and passTrend and passScore
                array.push(rIdx,   i)
                array.push(rType,  -1)
                array.push(rDist,  sPct)
                array.push(rProx,  sProx)
                array.push(rDist2, sDist)
                array.push(rScore, sScore)
                array.push(rTrend,       trendVal)
                array.push(rHtfTrend,    array.get(htfTrends,    i))
                array.push(rHtfDemDist,  array.get(htfDemDists,  i))
                array.push(rHtfDemScore, array.get(htfDemScores, i))
                array.push(rHtfSupDist,  array.get(htfSupDists,  i))
                array.push(rHtfSupScore, array.get(htfSupScores, i))

    nMatches = array.size(rIdx)

    // Sort matches by distPct ascending (closest zones first)
    if nMatches > 1
        for si = 1 to nMatches - 1
            keyDist  = array.get(rDist,  si)
            keyProx  = array.get(rProx,  si)
            keyDist2 = array.get(rDist2, si)
            keyScore = array.get(rScore, si)
            keyTrend       = array.get(rTrend,       si)
            keyHtfTrend    = array.get(rHtfTrend,    si)
            keyHtfDemDist  = array.get(rHtfDemDist,  si)
            keyHtfDemScore = array.get(rHtfDemScore, si)
            keyHtfSupDist  = array.get(rHtfSupDist,  si)
            keyHtfSupScore = array.get(rHtfSupScore, si)
            keyIdx         = array.get(rIdx,         si)
            keyType  = array.get(rType,  si)
            sj = si - 1
            while sj >= 0
                if array.get(rDist, sj) <= keyDist
                    break
                array.set(rDist,  sj + 1, array.get(rDist,  sj))
                array.set(rProx,  sj + 1, array.get(rProx,  sj))
                array.set(rDist2, sj + 1, array.get(rDist2, sj))
                array.set(rScore, sj + 1, array.get(rScore, sj))
                array.set(rTrend,       sj + 1, array.get(rTrend,       sj))
                array.set(rHtfTrend,    sj + 1, array.get(rHtfTrend,    sj))
                array.set(rHtfDemDist,  sj + 1, array.get(rHtfDemDist,  sj))
                array.set(rHtfDemScore, sj + 1, array.get(rHtfDemScore, sj))
                array.set(rHtfSupDist,  sj + 1, array.get(rHtfSupDist,  sj))
                array.set(rHtfSupScore, sj + 1, array.get(rHtfSupScore, sj))
                array.set(rIdx,         sj + 1, array.get(rIdx,         sj))
                array.set(rType,  sj + 1, array.get(rType,  sj))
                sj -= 1
            array.set(rDist,  sj + 1, keyDist)
            array.set(rProx,  sj + 1, keyProx)
            array.set(rDist2, sj + 1, keyDist2)
            array.set(rScore, sj + 1, keyScore)
            array.set(rTrend,       sj + 1, keyTrend)
            array.set(rHtfTrend,    sj + 1, keyHtfTrend)
            array.set(rHtfDemDist,  sj + 1, keyHtfDemDist)
            array.set(rHtfDemScore, sj + 1, keyHtfDemScore)
            array.set(rHtfSupDist,  sj + 1, keyHtfSupDist)
            array.set(rHtfSupScore, sj + 1, keyHtfSupScore)
            array.set(rIdx,         sj + 1, keyIdx)
            array.set(rType,        sj + 1, keyType)

    nCols    = 8
    bgColor  = color.new(color.black, 15)

    // Split results evenly across three side-by-side tables
    split1  = nMatches > 0 ? math.ceil(nMatches / 3) : 0
    split2  = nMatches > 0 ? math.ceil(nMatches * 2 / 3) : 0
    nData1  = split1
    nData2  = split2 - split1
    nData3  = nMatches - split2

    pos1 = tablePos == "Top" ? position.top_left    : position.bottom_left
    pos2 = tablePos == "Top" ? position.top_center  : position.bottom_center
    pos3 = tablePos == "Top" ? position.top_right   : position.bottom_right

    tbl1 := table.new(pos1, columns = nCols, rows = math.max(nData1, 1) + 1,
         bgcolor = bgColor, border_color = color.new(color.gray, 50), border_width = 1,
         frame_color = color.new(color.gray, 30), frame_width = 1)
    tbl2 := table.new(pos2, columns = nCols, rows = math.max(nData2, 1) + 1,
         bgcolor = bgColor, border_color = color.new(color.gray, 50), border_width = 1,
         frame_color = color.new(color.gray, 30), frame_width = 1)
    tbl3 := table.new(pos3, columns = nCols, rows = math.max(nData3, 1) + 1,
         bgcolor = bgColor, border_color = color.new(color.gray, 50), border_width = 1,
         frame_color = color.new(color.gray, 30), frame_width = 1)

    f_addHeader(tbl1)
    f_addHeader(tbl2)
    f_addHeader(tbl3)

    if nMatches == 0
        table.cell(tbl1, 0, 1, "No stocks match the criteria", text_color = color.gray, text_size = size.small, bgcolor = bgColor)
    else
        if split1 > 0
            for r = 0 to split1 - 1
                symIdx  = array.get(rIdx, r)
                fullSym = array.get(syms, symIdx)
                dispSym = str.length(fullSym) > 4 ? str.substring(fullSym, 4) : fullSym
                f_fillTblRow(tbl1, r + 1, dispSym, array.get(rType, r), array.get(rDist, r),
                     array.get(rProx, r), array.get(rDist2, r), array.get(rScore, r), array.get(rHtfTrend, r), array.get(rHtfDemDist, r), array.get(rHtfDemScore, r), array.get(rHtfSupDist, r), array.get(rHtfSupScore, r))

        if split2 > split1
            for r = split1 to split2 - 1
                symIdx  = array.get(rIdx, r)
                fullSym = array.get(syms, symIdx)
                dispSym = str.length(fullSym) > 4 ? str.substring(fullSym, 4) : fullSym
                f_fillTblRow(tbl2, r - split1 + 1, dispSym, array.get(rType, r), array.get(rDist, r),
                     array.get(rProx, r), array.get(rDist2, r), array.get(rScore, r), array.get(rHtfTrend, r), array.get(rHtfDemDist, r), array.get(rHtfDemScore, r), array.get(rHtfSupDist, r), array.get(rHtfSupScore, r))

        if nMatches > split2
            for r = split2 to nMatches - 1
                symIdx  = array.get(rIdx, r)
                fullSym = array.get(syms, symIdx)
                dispSym = str.length(fullSym) > 4 ? str.substring(fullSym, 4) : fullSym
                f_fillTblRow(tbl3, r - split2 + 1, dispSym, array.get(rType, r), array.get(rDist, r),
                     array.get(rProx, r), array.get(rDist2, r), array.get(rScore, r), array.get(rHtfTrend, r), array.get(rHtfDemDist, r), array.get(rHtfDemScore, r), array.get(rHtfSupDist, r), array.get(rHtfSupScore, r))

// Dummy plot so indicator renders on chart
plot(na)
