[dd20,dp20,ddi20,ds20, sd20,sp20,sdi20,ss20,tr20,ht20,hdd20,hdds20,hsd20,hsds20] = request.security(sym20, timeframe.period, f_scanZones(), lookahead = barmerge.lookahead_off)
